CANVAS_BASE_URL=https://utah.instructure.com

# Get your Canvas API token:
# 1. Log into Canvas
# 2. Go to Account > Settings
# 3. Scroll down to "Approved Integrations"
# 4. Click "+ New Access Token"
# 5. Copy the token and paste it above
